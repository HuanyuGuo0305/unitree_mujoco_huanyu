<mujoco model="b2wz1">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <!-- Keep your integrator choice -->
  <option integrator="implicitfast"/>

  <default>
    <!-- b2 defaults -->
    <default class="b2">
      <geom type="mesh"/>
      <joint damping="0" armature="0.1"/>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <!-- z1 defaults: aligned with "external PD torque -> d.ctrl" control -->
    <default class="z1">
      <!-- Keep passive effects small to avoid "double damping" (python kd already provides damping) -->
      <joint damping="0.1" frictionloss="0" armature="0.05"/>

      <!-- NOTE:
           We DO NOT define <general ...> here anymore, because we will not use position-servo actuators.
           All z1 actuators will be <motor>, and ctrl will represent TORQUE (same semantics as leg motors).
      -->
      <motor ctrlrange="-30 30"/>

      <default class="visual_z1">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>

      <default class="collision_z1">
        <geom type="cylinder" group="3" mass="0" density="0"/>
        <default class="z1_gripper_stator_collision">
          <geom type="mesh"/>
        </default>
        <default class="z1_gripper_stator_pad_collision_1">
          <geom type="box" size="0.014 0.015 0.004" pos="0.186 -0.015 -0.0125"/>
        </default>
        <default class="z1_gripper_stator_pad_collision_2">
          <geom type="box" size="0.014 0.015 0.004" pos="0.186 0.015 -0.0125"/>
        </default>
        <default class="z1_gripper_mover_collision">
