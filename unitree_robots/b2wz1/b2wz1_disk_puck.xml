<mujoco model="b2wz1 dynamic transport scene">
  <include file="b2wz1_disk.xml"/>

  <statistic center="0 0 0.3" extent="2.5"/>

  <!--
    E4 sim2sim alignment (2026-11-14): enable multi-point convex contact.
    Without multiccd, MuJoCo resolves the flat puck-on-disk (cylinder-cylinder)
    contact with ONE contact point, so the puck rocks and creeps off an inclined
    disk even when tan(tilt) < mu (incline diagnostic: mu=0.6 puck slid off a
    25 deg disk). With multiccd the pair produces 5 contacts and reproduces the
    Coulomb stick/slip threshold. Robot-only dynamics are bit-identical with and
    without this flag (verified), so it affects only convex pairs such as
    puck-disk.  See simulate_python/transport_experiment/docs/ALIGNMENT_REPORT.md.
  -->
  <option>
    <flag multiccd="enable"/>
  </option>

  <!-- Keep the retrieval sim2sim visual setup unchanged. -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
      rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"/>
    <material name="transport_puck_material" rgba="0.85 0.25 0.10 1.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- Keep the retrieval sim2sim ground unchanged. -->
    <geom name="floor"
      size="0 0 0.05"
      type="plane"
      material="groundplane"
      condim="3"
      friction="0.8 0.2 0.1"/>

    <!--
      Transport puck matching Isaac Lab nominal geometry:
        radius = 0.050 m
        height = 0.080 m (MuJoCo cylinder size uses HALF-height = 0.040 m)
        nominal mass = 0.500 kg

      Homogeneous solid-cylinder inertia at this mass/geometry:
        Ixx = Iyy = m*(3*r^2 + h^2)/12 = 0.0005791666666667 kg*m^2
        Izz         = m*r^2/2          = 0.0006250000000000 kg*m^2

      This XML stores NOMINAL values. A separate sim2sim runtime script must:
        - sample/assign puck mass in [0.50, 1.50] kg and scale inertia;
        - randomize sliding friction in [0.30, 1.00] as desired;
        - spawn puck with xy jitter +/-0.010 m and clearance 0.0005 m.

      MuJoCo does not have a direct 'restitution=0.0' geom attribute.
      solref='0.02 1' uses damping ratio 1 (no intended rebound), but is
      not numerically identical to Isaac Lab/PhysX restitution=0.

      E4 sim2sim alignment (2026-11-14):
        priority="1"  Isaac Lab uses the PhysX 'multiply' combine mode and the
                      disk/ground/robot carry the default material (mu = 1.0),
                      so every puck contact has effective mu = mu_puck.
                      MuJoCo's default rule is the element-wise MAX of the two
                      geoms, which made puck-disk friction 1.0 regardless of the
                      puck value. With a higher priority the puck geom alone
                      sets friction/solref/solimp of all of its contacts, which
                      reproduces mu_eff = mu_puck. Robot contacts are unchanged.
        solimp        Default soft contacts let a statically loaded puck creep
                      at ~1-2 mm/s (incline diagnostic). A stiffer impedance on
                      the puck's contacts reduces this ~10x without changing
                      the stick/slip threshold. PhysX friction has no such creep.
        margin/gap    Contacts are detected within 1 mm and become active within
                      0.5 mm (margin - gap), like PhysX contact/rest offsets.
                      Without it the near-zero resting penetration of the stiff
                      contact made the convex collider miss the flat contact
                      for single steps (puck dropped ~1 mm, contact flag chatter).
    -->
    <body name="transport_puck" pos="0 0 2">
      <freejoint name="transport_puck_freejoint"/>
      <inertial pos="0 0 0"
        mass="0.50"
        diaginertia="0.0005791666666667 0.0005791666666667 0.0006250000000000"/>
      <geom name="transport_puck_geom"
        type="cylinder"
        size="0.050 0.040"
        condim="3"
        friction="0.60 0.005 0.0001"
        priority="1"
        solref="0.02 1"
        solimp="0.99 0.999 0.001"
        margin="0.001"
        gap="0.0005"
        material="transport_puck_material"/>
    </body>
  </worldbody>
</mujoco>