<mujoco model="b2wz1 retrieval scene">
  <include file="b2wz1.xml"/>

  <statistic center="0 0 0.3" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="retrieval_cube_material" rgba="0.8 1.0 0.1 1.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane"
      material="groundplane" condim="3" friction="0.8 0.2 0.1"/>

    <!--
      5 cm retrieval cube matching the Isaac Lab task geometry.
      Its pose is overwritten at every episode reset by the deployment script.
    -->
    <body name="retrieval_cube" pos="0.8 0 0.026">
      <freejoint name="retrieval_cube_freejoint"/>
      <geom name="retrieval_cube_geom"
        type="box"
        size="0.025 0.025 0.025"
        mass="0.20"
        condim="3"
        friction="1.0 0.005 0.0001"
        material="retrieval_cube_material"/>
    </body>
  </worldbody>
</mujoco>